{%- comment -%}
  Usage : {% render 'price', target: product %} ou {% render 'price', target: variant %}
{%- endcomment -%}
{%- liquid
  assign target = target | default: product
  assign price = target.price
  assign compare = target.compare_at_price
-%}
<div class="price{% if compare != blank and compare > price %} price--on-sale{% endif %}">
  {%- if compare != blank and compare > price -%}
    <span class="price--compare">{{ compare | money }}</span>
  {%- endif -%}
  <span class="price__value">{{ price | money }}</span>
</div>
