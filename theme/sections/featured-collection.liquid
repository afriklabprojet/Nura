{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}

<section class="section{% if section.settings.alt %} section--alt{% endif %}">
  <div class="container">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="section-description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if collection != blank -%}
      <div class="product-grid">
        {%- for product in collection.products limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="product-card">
              <div class="product-card__media">
                {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__image placeholder-svg' }}
              </div>
              <div class="product-card__info">
                <span class="product-card__vendor">{{ 'onboarding.product_vendor' | t }}</span>
                <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
                <div class="product-card__price">{{ 4900 | money }}</div>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="product-grid">
        {%- for i in (1..4) -%}
          <div class="product-card">
            <div class="product-card__media">
              {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__image placeholder-svg' }}
            </div>
            <div class="product-card__info">
              <span class="product-card__vendor">{{ 'onboarding.product_vendor' | t }}</span>
              <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="product-card__price">{{ 4900 | money }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="text-center" style="margin-top: 2.5rem;">
        <a class="btn btn--outline" href="{{ collection.url | default: routes.all_products_collection_url }}">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection en avant",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Les essentiels"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Les essentiels Nura"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Découvrez les signatures parfumées de la maison."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Nombre de produits",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton"
    },
    {
      "type": "checkbox",
      "id": "alt",
      "label": "Fond alternatif",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Collection en avant"
    }
  ]
}
{% endschema %}
