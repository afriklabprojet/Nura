<section class="section section--dark">
  <div class="container">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="section-description" style="color: rgba(251,248,243,0.7);">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="ritual">
      {%- for block in section.blocks -%}
        <div class="ritual-step">
          <div class="ritual-step__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 768px) 33vw, 100vw',
                widths: '450, 550, 700'
              }}
            {%- else -%}
              {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <span class="ritual-step__number">{{ block.settings.number }}</span>
          <h3 class="ritual-step__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="ritual-step__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rituel Nura",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Le rituel Nura"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Parfumez. Hydratez. Sublimez."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Numéro",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Parfumez"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rituel Nura",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
