    "@medusajs/js-sdk": "2.21.0",
    "@medusajs/ui-preset": "2.21.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "clsx": "^2.1.1",
    "lodash": "^4.17.21",
    "meilisearch": "^0.56.0",
    "next": "16.4.0",
    "pg": "^8.11.3",
    "react": "19.0.5",
    "react-country-flag": "^3.1.0",
