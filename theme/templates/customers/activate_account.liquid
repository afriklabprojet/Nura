<section class="account">
  <h1 class="account__title">Activer votre compte</h1>

  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}

    <div class="account__field">
      <label class="account__label" for="activate-password">{{ 'customer.password' | t }}</label>
      <input class="account__input" type="password" id="activate-password" name="customer[password]" autocomplete="new-password" required>
    </div>

    <div class="account__field">
      <label class="account__label" for="activate-confirmation">Confirmation</label>
      <input class="account__input" type="password" id="activate-confirmation" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn--primary">Activer</button>
  {%- endform -%}
</section>
