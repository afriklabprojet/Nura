{%- comment -%}
  Formulaire produit (page produit).
  Usage : {% render 'product-form', product: product %}
{%- endcomment -%}
{%- liquid
  assign form_id = 'product-form-' | append: product.id
  assign selected = product.selected_or_first_available_variant
-%}

{%- capture variants_json -%}
{
{%- for v in product.variants -%}
  "{{ v.id }}": {"price": "{{ v.price | money | escape }}", "available": {{ v.available }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
}
{%- endcapture -%}

{%- form 'product', product, id: form_id, class: 'product-form', data-add-to-cart: '' -%}
  <script type="application/json" data-variants>{{ variants_json }}</script>

  {%- if product.has_only_default_variant -%}
    <input type="hidden" name="id" value="{{ selected.id }}">
  {%- else -%}
    <div class="product-form__row">
      <label class="product-form__label" for="{{ form_id }}-variant">
        {{ product.options_with_values[0].name }}
      </label>
      <select
        id="{{ form_id }}-variant"
        name="id"
        class="variant-select"
        data-variant-select
      >
        {%- for variant in product.variants -%}
          <option
            value="{{ variant.id }}"
            {% if variant == selected %}selected{% endif %}
            {% unless variant.available %}disabled{% endunless %}
          >
            {{ variant.title }} — {{ variant.price | money }}
            {%- unless variant.available %} ({{ 'product.sold_out' | t }}){% endunless -%}
          </option>
        {%- endfor -%}
      </select>
    </div>
  {%- endif -%}

  <div class="product-form__row">
    <label class="product-form__label" for="{{ form_id }}-quantity">{{ 'product.quantity' | t }}</label>
    <div class="quantity-field">
      <button type="button" data-qty-minus aria-label="Réduire la quantité">{%- render 'icon-minus' -%}</button>
      <input
        id="{{ form_id }}-quantity"
        type="number"
        name="quantity"
        value="1"
        min="1"
        inputmode="numeric"
        aria-label="{{ 'product.quantity' | t }}"
      >
      <button type="button" data-qty-plus aria-label="Augmenter la quantité">{%- render 'icon-plus' -%}</button>
    </div>
  </div>

  {%- if selected.available -%}
    <button
      type="submit"
      name="add"
      class="btn btn--primary product__add"
      data-error-message="{{ 'product.add_error' | t | escape }}"
      aria-live="polite"
    >
      {{ 'product.add_to_cart' | t }} — <span data-variant-price>{{ selected.price | money }}</span>
    </button>
  {%- else -%}
    <button type="button" class="btn btn--primary product__add" disabled>{{ 'product.sold_out' | t }}</button>
  {%- endif -%}
{%- endform -%}
