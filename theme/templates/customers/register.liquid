<section class="account">
  <h1 class="account__title">{{ 'customer.register' | t }}</h1>

  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}

    <div class="account__field">
      <label class="account__label" for="register-first">{{ 'customer.first_name' | t }}</label>
      <input class="account__input" type="text" id="register-first" name="customer[first_name]" autocomplete="given-name">
    </div>

    <div class="account__field">
      <label class="account__label" for="register-last">{{ 'customer.last_name' | t }}</label>
      <input class="account__input" type="text" id="register-last" name="customer[last_name]" autocomplete="family-name">
    </div>

    <div class="account__field">
      <label class="account__label" for="register-email">{{ 'customer.email' | t }}</label>
      <input class="account__input" type="email" id="register-email" name="customer[email]" autocomplete="email" required>
    </div>

    <div class="account__field">
      <label class="account__label" for="register-password">{{ 'customer.password' | t }}</label>
      <input class="account__input" type="password" id="register-password" name="customer[password]" autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn--primary">{{ 'customer.register' | t }}</button>
  {%- endform -%}

  <div class="account__links">
    <a href="{{ routes.account_login_url }}">{{ 'customer.login' | t }}</a>
  </div>
</section>
