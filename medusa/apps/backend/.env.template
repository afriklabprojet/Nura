STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Stripe (optional). Leave empty to keep the manual/test payment provider.
# Get keys at https://dashboard.stripe.com/test/apikeys and, for the webhook
# secret, https://dashboard.stripe.com/test/webhooks (endpoint: /hooks/payment/stripe_stripe).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Role-based access control (Super Admin / Admin / Manager profiles in the
# admin dashboard). See src/scripts/seed-rbac-roles.ts and
# src/api/middlewares.ts. IMPORTANT: once roles/policies exist, do not run
# `medusa user -e ... -p ...` again — on this Medusa version it wipes all
# custom RBAC policies as a side effect (confirmed bug). Create additional
# admin users through the dashboard's Settings > Team invite flow instead.
MEDUSA_FF_RBAC=true
MEDUSA_FF_RBAC_FILTER_FIELDS=true

# Resend (optional, transactional email — currently used by the /contact
# form). Leave empty to keep logging messages server-side instead of
# emailing them. Get a key at https://resend.com/api-keys; RESEND_FROM_EMAIL
# must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
