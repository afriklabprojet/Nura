{%- liquid
  assign menu = linklists[settings.menu]
  assign logo_img = settings.logo
  assign centered = false
  if settings.logo_position == 'center'
    assign centered = true
  endif
-%}

<header class="header{% if settings.sticky_header %} header--sticky{% endif %}" data-header>
  <div class="container header__inner">
    {%- if centered -%}
      <nav class="header__nav header__nav--left" aria-label="Navigation principale">
        <ul class="header__menu">
          {%- for link in menu.links -%}
            <li>
              <a class="header__link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <button type="button" class="header__icon header__toggle" data-open-menu aria-label="{{ 'header.menu' | t }}">
          {%- render 'icon-menu' -%}
        </button>
      </nav>
    {%- else -%}
      <button type="button" class="header__icon header__toggle" data-open-menu aria-label="{{ 'header.menu' | t }}">
        {%- render 'icon-menu' -%}
      </button>
    {%- endif -%}

    <div class="header__logo">
      <a class="header__logo-link" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {%- if logo_img != blank -%}
          <img
            class="header__logo-img"
            src="{{ logo_img | image_url: width: settings.logo_width | times: 2 }}"
            width="{{ settings.logo_width }}"
            height="{{ settings.logo_width | divided_by: logo_img.aspect_ratio | round }}"
            alt="{{ shop.name }}"
          >
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>
    </div>

    {%- if centered -%}
      <nav class="header__nav header__nav--right" aria-label="Actions">
        <div class="header__actions">
          <a class="header__icon" href="{{ routes.search_url }}" aria-label="{{ 'header.search' | t }}">
            {%- render 'icon-search' -%}
          </a>
          <a class="header__icon" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
            {%- render 'icon-account' -%}
          </a>
          <a class="header__icon" href="{{ routes.cart_url }}" data-open-cart aria-label="{{ 'header.cart' | t }}">
            {%- render 'icon-cart' -%}
            <span class="header__cart-count" data-cart-count{% if cart.item_count == 0 %} style="display:none;"{% endif %}>{{ cart.item_count }}</span>
          </a>
        </div>
      </nav>
    {%- else -%}
      <nav class="header__nav header__nav--right" aria-label="Navigation principale">
        <ul class="header__menu">
          {%- for link in menu.links -%}
            <li>
              <a class="header__link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <div class="header__actions">
          <a class="header__icon" href="{{ routes.search_url }}" aria-label="{{ 'header.search' | t }}">
            {%- render 'icon-search' -%}
          </a>
          <a class="header__icon" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
            {%- render 'icon-account' -%}
          </a>
          <a class="header__icon" href="{{ routes.cart_url }}" data-open-cart aria-label="{{ 'header.cart' | t }}">
            {%- render 'icon-cart' -%}
            <span class="header__cart-count" data-cart-count{% if cart.item_count == 0 %} style="display:none;"{% endif %}>{{ cart.item_count }}</span>
          </a>
        </div>
      </nav>
    {%- endif -%}
  </div>
</header>

{%- comment -%} Menu mobile {%- endcomment -%}
<div class="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu__header">
    <span class="header__logo-link">{{ shop.name }}</span>
    <button type="button" class="header__icon" data-close-menu aria-label="{{ 'general.accessibility.close' | t }}">
      {%- render 'icon-close' -%}
    </button>
  </div>
  <ul class="mobile-menu__list">
    {%- for link in menu.links -%}
      <li>
        <a class="mobile-menu__link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
          {{ link.title }}
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "En-tête"
}
{% endschema %}
