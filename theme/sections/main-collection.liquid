{%- paginate collection.products by section.settings.per_page -%}
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">{{ collection.title }}</span>
        <h1 class="section-heading">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <div class="section-description">{{ collection.description }}</div>
        {%- endif -%}
      </div>

      {%- if collection.products.size > 0 -%}
        <div class="collection-toolbar">
          <span class="collection-count">
            {{ 'products.product_count' | t: count: collection.products_count }}
          </span>

          <div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap;">
            {%- if collection.filters.size > 0 -%}
              <button type="button" class="filter-trigger" data-facets-toggle>
                {{ 'products.facets.filter' | t }}
              </button>
            {%- endif -%}

            <form method="get" action="{{ collection.url }}">
              {%- for filter in collection.filters -%}
                {%- for value in filter.active_values -%}
                  <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
                {%- endfor -%}
              {%- endfor -%}
              <select class="sort-select" name="sort_by" onchange="this.form.submit()">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                    {{ option.name }}
                  </option>
                {%- endfor -%}
              </select>
            </form>
          </div>
        </div>

        {%- if collection.filters.size > 0 -%}
          <div class="facets" data-facets>
            <div class="facets__grid">
              {%- for filter in collection.filters -%}
                <div class="facets__group">
                  <span class="facets__group-label">{{ filter.label }}</span>

                  {%- if filter.type == 'price' -%}
                    <form method="get" action="{{ collection.url }}">
                      {%- for f in collection.filters -%}
                        {%- if f.type != 'price' -%}
                          {%- for value in f.active_values -%}
                            <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
                          {%- endfor -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <div style="display:flex; gap:0.5rem; align-items:center;">
                        <input
                          type="number"
                          name="filter.v.price.gte"
                          value="{{ filter.min_value.value }}"
                          placeholder="{{ filter.min_value.value | default: 0 | money }}"
                          min="0"
                          class="contact-form__input"
                          style="max-width:110px;"
                        >
                        <span style="color:var(--brown-light);">—</span>
                        <input
                          type="number"
                          name="filter.v.price.lte"
                          value="{{ filter.max_value.value }}"
                          placeholder="{{ filter.range_max | money }}"
                          max="{{ filter.range_max }}"
                          class="contact-form__input"
                          style="max-width:110px;"
                        >
                        <button type="submit" class="btn btn--outline" style="min-height:44px; padding:0.5rem 1rem;">{{ 'products.facets.apply' | t }}</button>
                      </div>
                    </form>
                  {%- else -%}
                    <ul class="facets__values">
                      {%- for value in filter.values -%}
                        <li>
                          <a
                            class="facet-pill{% if value.active %} is-active{% endif %}"
                            href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                          >
                            {%- if value.active -%}✕{%- endif -%}
                            {{ value.label }}
                            {%- if value.count > 0 -%}<span style="opacity:.55;">({{ value.count }})</span>{%- endif -%}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="product-grid">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>

        {%- render 'pagination', paginate: paginate -%}
      {%- else -%}
        <p class="text-center" style="color: var(--brown-light);">
          {{ 'products.empty' | t }}
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Page collection",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Produits par page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
