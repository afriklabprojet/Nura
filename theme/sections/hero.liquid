<section class="hero section--flush">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '750, 1100, 1500, 1800, 2200, 2400'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__media placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="container hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1 class="hero__title">{{ section.settings.title | default: shop.name }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="btn btn--light" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo (optionnelle, prioritaire sur l'image)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Parfumerie & bodycare premium"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "NURA"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Votre aura commence ici."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Découvrir la collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
