<section class="section section--alt">
  <div class="container">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="instagram__grid">
      {%- for block in section.blocks -%}
        <a class="instagram__item" href="{{ block.settings.link | default: '#' }}" target="_blank" rel="noopener" aria-label="Publication Instagram Nura">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 500 | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 768px) 16vw, 33vw',
              widths: '300, 400, 500'
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.handle != blank -%}
      <div class="instagram__handle">
        <a href="https://instagram.com/{{ section.settings.handle | remove: '@' }}" target="_blank" rel="noopener">
          @{{ section.settings.handle | remove: '@' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Instagram",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Instagram"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "L'univers Nura au quotidien"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Compte Instagram",
      "default": "@nura"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Publication",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
