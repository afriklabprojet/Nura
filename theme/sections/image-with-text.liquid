<section class="section{% if section.settings.alt %} section--alt{% endif %}">
  <div class="container">
    <div class="image-text{% if section.settings.reverse %} image-text--reverse{% endif %}">
      <div class="image-text__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 900px) 50vw, 100vw',
            widths: '750, 900, 1100, 1400'
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="image-text__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="image-text__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="image-text__body">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--outline" href="{{ section.settings.cta_link | default: routes.root_url }}">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image avec texte",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "L'univers Nura"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Votre aura commence ici."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Nura imagine des parfums et des soins pensés pour accompagner chaque aura, chaque humeur et chaque moment.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Notre histoire"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Inverser (image à droite)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "alt",
      "label": "Fond alternatif",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Image avec texte"
    }
  ]
}
{% endschema %}
