<section class="account" style="max-width: 820px;">
  <h1 class="account__title">{{ 'customer.addresses' | t }}</h1>

  <div class="account__links">
    <a href="{{ routes.account_url }}">← {{ 'customer.account' | t }}</a>
  </div>

  {%- paginate customer.addresses by 5 -%}
    {%- for address in customer.addresses -%}
      <div class="notes" style="margin-top: 1.5rem;">
        <p style="margin:0; font-weight:300;">
          {{ address.first_name }} {{ address.last_name }}<br>
          {{ address.address1 }}{% if address.address2 != blank %}, {{ address.address2 }}{% endif %}<br>
          {{ address.zip }} {{ address.city }}, {{ address.country }}
        </p>
        <details style="margin-top: .75rem;">
          <summary class="btn btn--outline" style="display:inline-flex;">Modifier</summary>
          {%- form 'customer_address', address -%}
            <div class="account__field">
              <label class="account__label" for="address-first-{{ address.id }}">{{ 'customer.first_name' | t }}</label>
              <input class="account__input" type="text" id="address-first-{{ address.id }}" name="address[first_name]" value="{{ address.first_name }}">
            </div>
            <div class="account__field">
              <label class="account__label" for="address-last-{{ address.id }}">{{ 'customer.last_name' | t }}</label>
              <input class="account__input" type="text" id="address-last-{{ address.id }}" name="address[last_name]" value="{{ address.last_name }}">
            </div>
            <div class="account__field">
              <label class="account__label" for="address-address1-{{ address.id }}">Adresse</label>
              <input class="account__input" type="text" id="address-address1-{{ address.id }}" name="address[address1]" value="{{ address.address1 }}">
            </div>
            <div class="account__field">
              <label class="account__label" for="address-zip-{{ address.id }}">Code postal</label>
              <input class="account__input" type="text" id="address-zip-{{ address.id }}" name="address[zip]" value="{{ address.zip }}">
            </div>
            <div class="account__field">
              <label class="account__label" for="address-city-{{ address.id }}">Ville</label>
              <input class="account__input" type="text" id="address-city-{{ address.id }}" name="address[city]" value="{{ address.city }}">
            </div>
            <div class="account__field">
              <label class="account__label" for="address-country-{{ address.id }}">Pays</label>
              <select class="account__input" id="address-country-{{ address.id }}" name="address[country]" data-default="{{ address.country }}">
                {{ all_country_option_tags }}
              </select>
            </div>
            <button type="submit" class="btn btn--primary">Enregistrer</button>
          {%- endform -%}
        </details>

        <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" style="display:inline-block; margin-top: .75rem;">
          <input type="hidden" name="_method" value="delete">
          <button type="submit" class="btn btn--outline">Supprimer</button>
        </form>
      </div>
    {%- endfor -%}

    <div style="margin-top: 2.5rem;">
      <h3 class="footer__heading" style="color: var(--brown);">Ajouter une adresse</h3>
      {%- form 'customer_address', customer.new_address -%}
        <div class="account__field">
          <label class="account__label" for="address-first">{{ 'customer.first_name' | t }}</label>
          <input class="account__input" type="text" id="address-first" name="address[first_name]">
        </div>
        <div class="account__field">
          <label class="account__label" for="address-last">{{ 'customer.last_name' | t }}</label>
          <input class="account__input" type="text" id="address-last" name="address[last_name]">
        </div>
        <div class="account__field">
          <label class="account__label" for="address-address1">Adresse</label>
          <input class="account__input" type="text" id="address-address1" name="address[address1]">
        </div>
        <div class="account__field">
          <label class="account__label" for="address-zip">Code postal</label>
          <input class="account__input" type="text" id="address-zip" name="address[zip]">
        </div>
        <div class="account__field">
          <label class="account__label" for="address-city">Ville</label>
          <input class="account__input" type="text" id="address-city" name="address[city]">
        </div>
        <div class="account__field">
          <label class="account__label" for="address-country">Pays</label>
          <select class="account__input" id="address-country" name="address[country]">
            {{ all_country_option_tags }}
          </select>
        </div>
        <button type="submit" class="btn btn--primary">Enregistrer l'adresse</button>
      {%- endform -%}
    </div>

    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</section>
