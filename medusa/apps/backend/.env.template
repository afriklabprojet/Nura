STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=
COOKIE_SECRET=
ORDER_ACCESS_SECRET=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nura-backend
DATABASE_URL=
DB_NAME=medusa-backend

# Stripe (optional, Europe — cards). Leave empty to keep the manual/test
# payment provider. Get keys at https://dashboard.stripe.com/test/apikeys
# and, for the webhook secret, https://dashboard.stripe.com/test/webhooks
# (endpoint: /hooks/payment/stripe_stripe). Requires a verified Stripe
# business account (KYC documents) before going live.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Jèko (optional, Côte d'Ivoire — Wave/Orange Money/MTN/Moov/Djamo mobile
# money). Leave empty to keep the manual/test payment provider. Get
# credentials from the Jèko Dashboard Business (cockpit.jeko.africa) under
# Paramètres > API & Webhooks, once your account is verified (business
# documents required). JEKO_STORE_ID comes from GET /partner_api/stores.
# Webhook endpoint: /hooks/payment/jeko_jeko.
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=

# Role-based access control (Super Admin / Admin / Manager profiles in the
# admin dashboard). See src/scripts/seed-rbac-roles.ts and
# src/api/middlewares.ts. IMPORTANT: once roles/policies exist, do not run
# `medusa user -e ... -p ...` again — on this Medusa version it wipes all
# custom RBAC policies as a side effect (confirmed bug). Create additional
# admin users through the dashboard's Settings > Team invite flow instead.
MEDUSA_FF_RBAC=true
MEDUSA_FF_RBAC_FILTER_FIELDS=true

# Resend (required in production, optional for local development). Covers the
# contact form, order lifecycle, password reset and email verification. Get a key at
# https://resend.com/api-keys; RESEND_FROM_EMAIL must be on a domain
# verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public URL of the storefront (no trailing slash). Used to build links in
# transactional emails (password reset, email verification, order
# confirmation). Required in production; local development defaults to
# http://localhost:8000.
STOREFRONT_URL=

# Referral rewards in major currency units. Review these commercial values
# before launch; both codes are single-use and only issued after paid orders.
REFERRAL_REWARD_EUR=10
REFERRAL_REWARD_XOF=6500

# --- Instant content refresh (optional, recommended) ---
# Shared secret between the backend and the storefront. When both sides
# carry the same value, saving the Journal or a home page section in the
# admin refreshes the shop straight away; without it the shop picks the
# change up at the end of its cache window instead. Any long random string
# works — e.g. `openssl rand -hex 32`.
REVALIDATE_SECRET=

# Product search (optional, self-hosted — see docker-compose.yml). Leave
# empty to keep browsing by category/collection only, no search bar.
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
