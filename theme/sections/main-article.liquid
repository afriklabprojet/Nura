<article class="article">
  <div class="container">
    <header class="article__header">
      <span class="article__meta">{{ article.published_at | date: '%d.%m.%Y' }} · {{ article.author }}</span>
      <h1 class="article__title">{{ article.title }}</h1>
    </header>

    {%- if article.image -%}
      <div class="article__image">
        {{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '100vw', widths: '750, 1100, 1400' }}
      </div>
    {%- endif -%}

    <div class="rte">{{ article.content }}</div>

    <div style="margin-top: 3rem;">
      <a class="btn btn--outline" href="{{ blog.url }}">← {{ blog.title }}</a>
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Page article"
}
{% endschema %}
