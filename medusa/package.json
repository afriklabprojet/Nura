{
  "name": "medusa",
  "private": false,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.0",
    "ajv": "^8.13.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    },
    "@graphql-codegen/plugin-helpers": {
      "lodash": "4.18.1"
    },
    "@graphql-tools/utils": "12.0.3",
    "compression": "1.8.2",
    "proxy-addr": "2.0.8",
    "react": "19.0.5",
    "react-dom": "19.0.5",
    "source-map-js": "1.2.2",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild": true,
    "msgpackr-extract": true,
    "protobufjs": true,
    "unrs-resolver": true,
    "@medusajs/telemetry": true,
    "@swc/core": true,
    "tailwindcss-radix": false
  },
  "dependencies": {
    "@medusajs/medusa": "2.21.0",
    "@medusajs/types": "2.21.0",
    "caniuse-lite": "^1.0.30001810",
    "date-fns": "^3.6.0",
    "react-aria": "^3.52.1",
    "rxjs": "^7.8.2"
  }
}
