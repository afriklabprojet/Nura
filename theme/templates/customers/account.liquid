<section class="account" style="max-width: 760px;">
  <h1 class="account__title">{{ 'customer.account' | t }}</h1>

  <p class="text-center" style="color: var(--brown-light);">
    Bonjour, {{ customer.first_name | default: customer.email }}.
    <a href="{{ routes.account_logout_url }}" style="color: var(--gold); text-decoration: underline;">{{ 'customer.logout' | t }}</a>
  </p>

  <h3 class="footer__heading" style="margin-top: 2.5rem; color: var(--brown);">{{ 'customer.orders' | t }}</h3>

  {%- if customer.orders.size > 0 -%}
    <table class="account__table">
      <thead>
        <tr>
          <th>{{ 'customer.order' | t }}</th>
          <th>Date</th>
          <th>Statut de paiement</th>
          <th>Statut de livraison</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {%- for order in customer.orders -%}
          <tr>
            <td><a href="{{ order.customer_url }}" style="color: var(--gold);">#{{ order.name }}</a></td>
            <td>{{ order.created_at | date: '%d.%m.%Y' }}</td>
            <td>{{ order.financial_status_label }}</td>
            <td>{{ order.fulfillment_status_label }}</td>
            <td>{{ order.total_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- else -%}
    <p style="color: var(--brown-light);">{{ 'customer.no_orders' | t }}</p>
    <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  {%- endif -%}

  <div class="account__links" style="margin-top: 2rem;">
    <a href="{{ routes.account_addresses_url }}">{{ 'customer.view_addresses' | t }}</a>
  </div>
</section>
