{%- comment -%}
  Panier coulissant (drawer) — rendu globalement depuis theme.liquid.
{%- endcomment -%}
<aside class="cart-drawer" data-cart-drawer data-section-id="{{ section.id }}" aria-hidden="true">
  <div class="cart-drawer__header">
    <h2 class="cart-drawer__title">{{ 'cart.title' | t }}</h2>
    <button type="button" class="cart-drawer__close" data-close-cart aria-label="{{ 'general.accessibility.close' | t }}">
      {%- render 'icon-close' -%}
    </button>
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="cart-drawer__items">
      {%- for item in cart.items -%}
        <div class="cart-item">
          <a href="{{ item.url }}">
            {%- if item.image -%}
              <img
                class="cart-item__image"
                src="{{ item.image | image_url: width: 160 }}"
                width="76"
                height="96"
                alt="{{ item.image.alt | default: item.product.title | escape }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'cart-item__image' }}
            {%- endif -%}
          </a>
          <div class="cart-item__info">
            <h3 class="cart-item__title">
              <a href="{{ item.url }}">{{ item.product.title }}</a>
            </h3>
            {%- unless item.product.has_only_default_variant -%}
              <span class="cart-item__variant">{{ item.variant.title }}</span>
            {%- endunless -%}
            <div class="cart-item__price">{{ item.final_line_price | money }} · Qté {{ item.quantity }}</div>
            <a class="cart-item__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="cart-drawer__footer">
      <div class="cart-drawer__subtotal">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span>{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-drawer__note">{{ settings.cart_note }}</p>
      <a class="btn btn--primary" href="/checkout">{{ 'cart.checkout' | t }}</a>
      <a class="btn btn--outline" href="{{ routes.cart_url }}" style="margin-top: 0.5rem;">{{ 'cart.view' | t }}</a>
    </div>
  {%- else -%}
    <div class="cart-drawer__empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    </div>
  {%- endif -%}
</aside>

{% schema %}
{
  "name": "Panier coulissant"
}
{% endschema %}
