<section class="section{% if section.settings.alt %} section--alt{% endif %}">
  <div class="container">
    <div class="newsletter">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="newsletter__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="newsletter__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- assign newsletter_form_id = 'NewsletterForm-' | append: section.id -%}
      {%- form 'customer', id: newsletter_form_id, class: 'newsletter__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="newsletter__success newsletter__success--visible" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="newsletter__error form-error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            class="newsletter__input"
            type="email"
            name="contact[email]"
            value="{{ form.email | escape }}"
            placeholder="{{ 'general.newsletter.label' | t }}"
            aria-label="{{ 'general.newsletter.label' | t }}"
            autocomplete="email"
            autocapitalize="off"
            autocorrect="off"
            required
          >
          <button type="submit" class="newsletter__submit">{{ 'newsletter.submit' | t }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Entrez dans l'univers Nura."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Nouveautés, lancements, offres exclusives et conseils parfum & bodycare."
    },
    {
      "type": "checkbox",
      "id": "alt",
      "label": "Fond alternatif",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
