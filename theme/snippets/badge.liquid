{%- comment -%}
  Usage : {% render 'badge', product: product %}
  Lit le metafield custom.badge : Best-seller / Nouveau / Édition limitée
{%- endcomment -%}
{%- liquid
  assign badge = product.metafields.custom.badge
-%}
{%- if badge != blank -%}
  {%- assign badge_handle = badge | downcase | handle -%}
  <span class="badge{% if badge_handle == 'best-seller' %} badge--gold{% elsif badge_handle == 'nouveau' %} badge--dark{% elsif badge_handle == 'edition-limitee' %} badge--gold{% endif %}">
    {{ badge }}
  </span>
{%- endif -%}
