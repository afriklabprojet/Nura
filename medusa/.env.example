# Copy to .env and fill in before running `docker compose up -d --build`.
# This file is read by docker-compose.yml only — it is separate from
# apps/backend/.env(.local) and apps/storefront/.env(.local), which are
# only used for local `npm run dev`.

# --- Secrets (generate with: openssl rand -hex 32) ---
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
ORDER_ACCESS_SECRET=
# Used by scripts/backup-postgres.sh; keep it outside source control and
# different from application secrets.
BACKUP_ENCRYPTION_KEY=

# --- Domains ---
STOREFRONT_DOMAIN=nura-paris.com
BACKEND_DOMAIN=api.nura-paris.com
# Comma-separated origins allowed to call the backend.
STORE_CORS=https://nura-paris.com
ADMIN_CORS=https://api.nura-paris.com
AUTH_CORS=https://nura-paris.com,https://api.nura-paris.com

# --- Storefront build args (baked in at build time) ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.nura-paris.com
NEXT_PUBLIC_BASE_URL=https://nura-paris.com
NEXT_PUBLIC_DEFAULT_REGION=fr
# Create this in the admin (Settings > API Key Management > Publishable
# Keys) after the first deploy, then set it here and re-run
# `docker compose up -d --build storefront`.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# --- Legal identity (required to build the production storefront) ---
# Use "Sans objet" where a field legally does not apply to your structure.
LEGAL_LAST_UPDATED=
LEGAL_BUSINESS_NAME=
LEGAL_FORM=
LEGAL_CAPITAL=
LEGAL_REGISTRY_CITY=
LEGAL_REGISTRATION_NUMBER=
LEGAL_VAT_NUMBER=
LEGAL_ADDRESS=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=
LEGAL_MEDIATOR_NAME=
LEGAL_MEDIATOR_URL=

# --- Stripe (optional, Europe — cards) ---
# Requires a verified Stripe business account (KYC documents) first.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_KEY=

# --- Jèko (optional, Côte d'Ivoire — Wave/Orange Money/MTN/Moov/Djamo) ---
# Requires a verified Jèko business account (KYB documents) first. Get
# credentials from cockpit.jeko.africa under Paramètres > API & Webhooks.
# JEKO_STORE_ID comes from GET /partner_api/stores.
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=
# Confirm both values against your Jèko contract and test environment.
JEKO_API_URL=https://api.jeko.africa/partner_api
JEKO_AMOUNT_MULTIPLIER=

# --- Resend (required in production: contact form, order lifecycle,
# password reset, email verification, newsletter signup) ---
# Get a key at https://resend.com/api-keys. RESEND_FROM_EMAIL must be on a
# domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Referral economics (major currency units) ---
REFERRAL_REWARD_EUR=10
REFERRAL_REWARD_XOF=6500

# --- Persistent media (AWS S3, Cloudflare R2, or compatible) ---
S3_FILE_URL=https://media.nura-paris.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=

# --- Observability (optional OTLP-compatible collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Automatic market detection (self-hosted GeoIP via Caddy) ---
# Free MaxMind account + license key: https://www.maxmind.com/en/geolite2/signup
# Used to detect Côte d'Ivoire visitors and route them to the XOF/Jèko
# market automatically — see "Détection automatique du marché" in
# DEPLOYMENT.md. Without these, everyone gets the default market
# (NEXT_PUBLIC_DEFAULT_REGION) until they pick a country manually.
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=

# --- Product search (self-hosted Meilisearch) ---
# MEILISEARCH_API_KEY is the Meilisearch master key (generate with:
# openssl rand -hex 16) — used by the backend to index products.
# NEXT_PUBLIC_MEILISEARCH_API_KEY is a separate, search-only key created in
# the running Meilisearch instance after first deploy (see DEPLOYMENT.md);
# it's exposed to the browser, so it must never be the master key above.
MEILISEARCH_API_KEY=
NEXT_PUBLIC_MEILISEARCH_HOST=https://api.nura-paris.com/meilisearch
NEXT_PUBLIC_MEILISEARCH_API_KEY=

# --- Instant content refresh (required in production) ---
# Shared secret between the backend and the storefront. When both sides
# carry the same value, saving the Journal or a home page section in the
# admin refreshes the shop straight away. Generate it with
# `openssl rand -hex 32` and use the same value in both services.
REVALIDATE_SECRET=

# The catalogue seed uses placeholder Unsplash photography. Keep this false
# in production unless you explicitly accept those temporary assets.
ALLOW_PLACEHOLDER_PRODUCT_IMAGES=false
# --- Marketing tracking (optional) ---
# All three are optional and independent. Each is only loaded on the
# storefront once a visitor accepts the "mesure d'audience et publicité"
# cookies in the consent banner — never before, and never at all if left
# blank here.
# GA4 measurement ID, e.g. G-XXXXXXXXXX — from Google Analytics > Admin >
# Data Streams.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta (Facebook/Instagram) Pixel ID — from Meta Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok Pixel ID — from TikTok Ads Manager > Assets > Events.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Contact details, social links, and WhatsApp visibility are managed in Admin.

# Local standalone testing only; never set this in a public deployment.
ALLOW_LOCALHOST_PRODUCTION_BUILD=false
