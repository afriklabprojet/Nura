<section class="account">
  <h1 class="account__title">{{ 'customer.login' | t }}</h1>

  {%- form 'customer_login' -%}
    {{ form.errors | default_errors }}

    <div class="account__field">
      <label class="account__label" for="customer-email">{{ 'customer.email' | t }}</label>
      <input class="account__input" type="email" id="customer-email" name="customer[email]" autocomplete="email" required>
    </div>

    <div class="account__field">
      <label class="account__label" for="customer-password">{{ 'customer.password' | t }}</label>
      <input class="account__input" type="password" id="customer-password" name="customer[password]" autocomplete="current-password" required>
    </div>

    <button type="submit" class="btn btn--primary">{{ 'customer.login' | t }}</button>
  {%- endform -%}

  <div class="account__links">
    <a href="{{ routes.account_register_url }}">{{ 'customer.register' | t }}</a>
    <span style="opacity:.5;">·</span>
    <a href="#recover">Mot de passe oublié ?</a>
  </div>

  {%- form 'recover_customer_password' -%}
    <div class="account__field" style="margin-top: 2rem;">
      <label class="account__label" for="recover-email">{{ 'customer.email' | t }}</label>
      <input class="account__input" type="email" id="recover-email" name="email" autocomplete="email">
    </div>
    <button type="submit" class="btn btn--outline">Réinitialiser le mot de passe</button>
  {%- endform -%}
</section>
