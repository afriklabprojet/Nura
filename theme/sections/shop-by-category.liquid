<section class="section">
  <div class="container">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="section-description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="categories">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <a class="category-card" href="{{ collection.url | default: routes.all_products_collection_url }}">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag:
              class: 'category-card__image',
              loading: 'lazy',
              sizes: '(min-width: 768px) 33vw, 100vw',
              widths: '500, 750, 900'
            }}
          {%- elsif collection.featured_image != blank -%}
            {{ collection.featured_image | image_url: width: 900 | image_tag:
              class: 'category-card__image',
              loading: 'lazy',
              sizes: '(min-width: 768px) 33vw, 100vw',
              widths: '500, 750, 900'
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'category-card__image placeholder-svg' }}
          {%- endif -%}
          <span class="category-card__content">
            <span class="category-card__title">{{ block.settings.title | default: collection.title }}</span>
            <span class="category-card__cta">Découvrir</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Catégories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Explorez l'univers Nura"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Catégories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
